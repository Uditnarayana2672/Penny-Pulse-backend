# Copy to .env. Never commit .env — it holds the service-role key.
# Supabase project: Penny Pulse · ref aicizmcvkqcbrsxmdpyj · ap-south-1

# Session pooler connection string (port 6543 pooler, or 5432 direct).
# Password is the database password, URL-encoded.
DATABASE_URL=postgresql+psycopg://postgres.aicizmcvkqcbrsxmdpyj:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Project JWT secret. Access tokens are verified locally against this — no
# network call to Supabase per request (rules/api.md, Auth).
SUPABASE_JWT_SECRET=

# Expected `aud` claim on a Supabase access token.
SUPABASE_JWT_AUDIENCE=authenticated

# Origins allowed to call this API. Comma-separated.
CORS_ORIGINS=http://localhost:5173

# debug | info | warning | error
LOG_LEVEL=info
