# Copy to .env. Never commit .env — it holds the service-role key.
# Supabase project: Penny Pulse · ref aicizmcvkqcbrsxmdpyj · ap-south-1

# Session pooler: port 5432 on the POOLER host, user postgres.<project-ref>.
# Not 6543 — that is transaction mode, where psycopg3's automatic prepared statements
# break. Not db.<ref>.supabase.co either — direct connections are IPv6-only without the
# IPv4 add-on, and that host does not resolve here.
# PASSWORD must be URL-encoded: a literal @ : / ? # makes the parser misread the host.
DATABASE_URL=postgresql+psycopg://postgres.aicizmcvkqcbrsxmdpyj:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Project API URL. The backend derives the JWKS endpoint and the expected `iss`
# claim from it. Access tokens are ES256 and are verified locally against the
# published public key — no shared secret, and no network call to Supabase on the
# request path (rules/api.md, Auth). No trailing slash.
SUPABASE_URL=https://aicizmcvkqcbrsxmdpyj.supabase.co

# Expected `aud` claim on a Supabase access token.
SUPABASE_JWT_AUDIENCE=authenticated

# Origins allowed to call this API. Comma-separated.
CORS_ORIGINS=http://localhost:5173

# debug | info | warning | error
LOG_LEVEL=info
